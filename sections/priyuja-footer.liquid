    {
      "type": "header",
      "content": "Varanasi location"
    },
    {
      "type": "text",
      "id": "varanasi_label",
      "label": "Heading",
      "default": "Varanasi — Store & Sourcing"
    },
    {
      "type": "textarea",
      "id": "varanasi_address",
      "label": "Address",
      "default": "D 47/195, 2nd Floor, Luxa Rd, opp. PDR Mall, Ramapura, Varanasi, Uttar Pradesh 221010"
    },
    {
      "type": "text",
      "id": "varanasi_hours",
      "label": "Hours",
      "default": "Mon–Sat, 10 AM – 8 PM"
    },
    {
      "type": "text",
      "id": "varanasi_gst",
      "label": "GSTIN",
      "default": "09AADCO1764H1ZC"
    },
    {
      "type": "header",
      "content": "Links"
    },
    {
      "type": "text",
      "id": "menu_title",
      "label": "Links column title",
      "default": "Explore"
    },
    {
      "type": "link_list",
