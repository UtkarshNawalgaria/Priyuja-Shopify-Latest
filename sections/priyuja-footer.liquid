    {
      "type": "header",
      "content": "Mumbai location"
    },
    {
      "type": "text",
      "id": "mumbai_label",
      "label": "Heading",
      "default": "Mumbai — Sales Office"
    },
    {
      "type": "textarea",
      "id": "mumbai_address",
      "label": "Address",
      "default": "B-39, 2nd Floor, Flameproof House, Veera Desai Industrial Estate, New Link Road, Andheri West, Mumbai, Maharashtra 400053"
