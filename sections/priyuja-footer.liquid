<style>
  #shopify-section-{{ section.id }} {
    --maroon: var(--priyuja-maroon, #6B1628);
    --maroon-deep: var(--priyuja-maroon-deep, #4A0F1C);
    --gold-light: var(--priyuja-gold-light, #E3C877);
    --font-heading: var(--priyuja-font-heading, serif);
    --font-body: var(--priyuja-font-body, sans-serif);
  }
  #shopify-section-{{ section.id }} * { box-sizing: border-box; }

  .pf { background: var(--maroon-deep); color: #ecdcc6; font-family: var(--font-body); line-height: 1.65; }
  .pf__wrap { max-width: 1100px; margin: 0 auto; padding: 48px 28px 24px; }
  .pf__grid { display: grid; grid-template-columns: 1.15fr 1.15fr 1fr; gap: 44px; }

  .pf__col h4 { font-family: var(--font-body); text-transform: uppercase; letter-spacing: 1.6px; font-size: 12px; font-weight: 700; color: var(--gold-light); margin: 0 0 12px; }
  .pf__store address { font-style: normal; color: #e0cdb2; font-size: 14px; margin: 0; }
  .pf__store .row { display: block; margin-top: 8px; }
  .pf__store .lbl { color: var(--gold-light); font-weight: 600; }

  .pf__links ul { list-style: none; margin: 0; padding: 0; }
  .pf__links li { margin: 0 0 9px; }
  .pf__links a { color: #e0cdb2; text-decoration: none; font-size: 14px; transition: color .2s ease; }
  .pf__links a:hover, .pf__links a:focus-visible { color: var(--gold-light); text-decoration: underline; }

  .pf__bottom { border-top: 1px solid rgba(255,255,255,.14); margin-top: 36px; padding-top: 18px; text-align: center; font-size: 12.5px; color: #c2ab90; }

  @media (max-width: 820px) {
    .pf__grid { grid-template-columns: 1fr 1fr; gap: 32px; }
  }
  @media (max-width: 600px) {
    .pf__wrap { padding: 36px 20px 20px; }
    .pf__grid { grid-template-columns: 1fr; gap: 28px; }
  }
</style>

<footer class="pf" role="contentinfo">
  <div class="pf__wrap">
    <div class="pf__grid">

      <div class="pf__col pf__store">
        <h4>{{ section.settings.mumbai_label | default: 'Mumbai Office' }}</h4>
        <address>
          {{ section.settings.mumbai_address }}
          {%- if section.settings.mumbai_hours != blank -%}
            <span class="row"><span class="lbl">Hours:</span> {{ section.settings.mumbai_hours }}</span>
          {%- endif -%}
          {%- if section.settings.mumbai_gst != blank -%}
            <span class="row"><span class="lbl">GSTIN:</span> {{ section.settings.mumbai_gst }}</span>
          {%- endif -%}
        </address>
      </div>

      <div class="pf__col pf__store">
        <h4>{{ section.settings.varanasi_label | default: 'Varanasi Store' }}</h4>
        <address>
          {{ section.settings.varanasi_address }}
          {%- if section.settings.varanasi_hours != blank -%}
            <span class="row"><span class="lbl">Hours:</span> {{ section.settings.varanasi_hours }}</span>
          {%- endif -%}
          {%- if section.settings.varanasi_gst != blank -%}
            <span class="row"><span class="lbl">GSTIN:</span> {{ section.settings.varanasi_gst }}</span>
          {%- endif -%}
        </address>
      </div>

      <div class="pf__col pf__links">
        <h4>Sarees &amp; Wholesale</h4>
        <ul>
          <li><a href="/pages/best-banarasi-saree-shop-in-varanasi">Best Banarasi Saree Shop in Varanasi</a></li>
          <li><a href="/pages/best-wholesale-saree-store-in-varanasi">Wholesale Saree Store in Varanasi</a></li>
          <li><a href="/pages/katan-banarasi-silk-saree-wholesaler">Katan Banarasi Silk Sarees</a></li>
          <li><a href="/pages/banarasi-organza-saree-wholesaler">Banarasi Organza Sarees</a></li>
          <li><a href="/pages/banarasi-georgette-saree-wholesaler">Banarasi Georgette Sarees</a></li>
          <li><a href="/pages/banarasi-tissue-saree-wholesaler">Banarasi Tissue Sarees</a></li>
        </ul>
      </div>

    </div>

    <div class="pf__bottom">
      © {{ 'now' | date: '%Y' }} {{ section.settings.brand_name | default: 'Priyuja' }}{%- if section.settings.copyright_text != blank -%} · {{ section.settings.copyright_text }}{%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Priyuja Footer",
  "settings": [
    {
      "type": "header",
      "content": "Mumbai location"
    },
    {
      "type": "text",
      "id": "mumbai_label",
      "label": "Heading",
      "default": "Mumbai Office"
    },
    {
      "type": "textarea",
      "id": "mumbai_address",
      "label": "Address",
      "default": "B-39, 2nd Floor, Flameproof House, Veera Desai Industrial Estate, New Link Road, Andheri West, Mumbai, Maharashtra 400053"
    },
    {
      "type": "text",
      "id": "mumbai_hours",
      "label": "Hours",
      "info": "e.g. Mon–Sat, 11 AM – 7 PM. Leave blank to hide."
    },
    {
      "type": "text",
      "id": "mumbai_gst",
      "label": "GSTIN",
      "default": "27AADCO1764H1ZE"
    },
    {
      "type": "header",
      "content": "Varanasi location"
    },
    {
      "type": "text",
      "id": "varanasi_label",
      "label": "Heading",
      "default": "Varanasi Store"
    },
    {
      "type": "textarea",
      "id": "varanasi_address",
      "label": "Address",
      "default": "D 47/195, 2nd Floor, Luxa Rd, opp. PDR Mall, Ramapura, Varanasi, Uttar Pradesh 221010"
    },
    {
      "type": "text",
      "id": "varanasi_hours",
      "label": "Hours",
      "default": "Mon–Sat, 10 AM – 8 PM"
    },
    {
      "type": "text",
      "id": "varanasi_gst",
      "label": "GSTIN",
      "default": "09AADCO1764H1ZC"
    },
    {
      "type": "header",
      "content": "Bottom bar"
    },
    {
      "type": "text",
      "id": "brand_name",
      "label": "Brand name (copyright)",
      "default": "Priyuja"
    },
    {
      "type": "text",
      "id": "copyright_text",
      "label": "Copyright suffix",
      "default": "Powered by Olivecloud"
    }
  ],
  "presets": [
    {
      "name": "Priyuja Footer"
    }
  ],
  "enabled_on": {
    "groups": ["footer"]
  }
}
{% endschema %}
